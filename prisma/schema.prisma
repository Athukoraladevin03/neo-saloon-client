// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id String @id @default(uuid())
  email String @unique
  phone String? @unique
  firstname String
  lastname String
  password String
  role String @default("CUSTOMER")
  status String @default("ACTIVE") //ACTIVE, BANNED, SUSPENDED
  createdAt DateTime @default(now())
  lastLogin DateTime?
  privilages String[] @default([]) //["users:add" , "users:edit" , "users.read"]
  profileImage String? @default("images/default-profile.png") //should be included in the token
  //gender, emailVerified, phoneVerified
  
}

enum ProductStatus {
  ACTIVE
  BANNED
  DELETED
}


model product {
  id String @id @default(uuid())
  sku String @unique
  name String
  altNames String[] @default([])
  description String
  stock Int @default(0)
  // status String @default("ACTIVE") //ACTIVE, BANNED, DISCONTNUED
  status ProductStatus @default(ACTIVE)
  price Float
  compareAt Float?
  brand String?
  model String?
  media Media[]
}

enum MediaType {
  IMAGE
  VIDEO
}


model Media{
  id String @id @default (uuid())
  url String
  type MediaType
  productId String
  product product @relation(fields: [productId], references: [id])
}